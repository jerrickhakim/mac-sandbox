{
  "name": "mac-sandbox",
  "version": "1.0.1",
  "description": "Create and manage sandboxes on your Mac with a simple CLI and API. Using Apple Containers and Cloudflare Tunnels",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sandbox": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/cli/index.ts start",
    "build": "tsc -p tsconfig.json",
    "link": "npm run build && npm link && sandbox start",
    "start": "npm run build && node dist/cli/index.js start",
    "serve": "node dist/cli/index.js start",
    "prepublishOnly": "npm run build",
    "test": "node --test",
    "test:git-sandbox": "tsx test-git-sandbox.ts",
    "lint": "tsc --noEmit",
    "t": "./test-all-endpoints.ts"
  },
  "keywords": [
    "sandbox",
    "mac",
    "container",
    "development",
    "isolation",
    "vm",
    "apple-containers"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jerrickhakim/mac-sandbox"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.1",
    "@scalar/hono-api-reference": "^0.9.44",
    "chalk": "^5.6.2",
    "hono": "^4.10.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
